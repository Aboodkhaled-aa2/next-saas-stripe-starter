// This is your Prisma schema file,
// learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum Plan {
  STARTER
  BUSINESS
  PRO
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  LOST
}

enum AIPhoneStatus {
  NOT_CONFIGURED
  READY
  ACTIVE
  DISCONNECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)
  plan          Plan      @default(STARTER)

  accounts Account[]
  sessions Session[]

  businessProfile BusinessProfile?
  leads           Lead[]
  customers       Customer[]
  employees       Employee[]
  bookings        Booking[]
  passwordResetTokens PasswordResetToken[]

  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  stripePriceId          String?   @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map("stripe_current_period_end")

  @@map("users")
}

model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique

  businessName  String?
  businessPhone String?
  businessEmail String?
  websiteUrl    String?

  services      Json?
  serviceAreas  Json?
  pricing       Json?
  businessHours Json?

  paymentMethods     Json?
  bookingRules       Json?
  cancellationPolicy String? @db.Text
  reschedulingPolicy String? @db.Text

  aiInstructions           String? @db.Text
  aiTone                   String?
  humanHandoffInstructions String? @db.Text
  additionalNotes          String? @db.Text

  onboardingCompleted Boolean @default(false)

  aiPhoneSettings AIPhoneSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model AIPhoneSettings {
  id String @id @default(cuid())

  businessProfileId String @unique

  status AIPhoneStatus @default(NOT_CONFIGURED)

  provider    String?
  phoneNumber String?

  assistantName String?
  greeting     String?
  enabled      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("ai_phone_settings")
}

model Employee {
  id     String  @id @default(cuid())
  userId String

  name     String
  phone    String?
  email    String?
  active   Boolean @default(true)
  teamName String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, active])
  @@map("employees")
}

model Booking {
  id     String @id @default(cuid())
  userId String

  customerId String?
  employeeId String?

  customerName  String
  customerPhone String?
  customerEmail String?
  address       String?

  service       String
  propertyType  String?
  bedrooms     Int?
  bathrooms    Int?
  propertySize String?
  notes         String? @db.Text

  startAt DateTime
  endAt   DateTime

  durationMinutes     Int
  travelBufferMinutes Int @default(0)

  status BookingStatus @default(PENDING)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
  @@index([userId, endAt])
  @@index([employeeId, startAt])
  @@index([customerId])
  @@map("bookings")
}

model Lead {
  id String @id @default(cuid())

  userId String

  name        String?
  phone       String?
  email       String?
  source      String?
  service     String?
  location    String?
  lastMessage String? @db.Text

  status LeadStatus @default(NEW)

  quoteAmount Float?
  followUpAt  DateTime?
  notes       String? @db.Text

  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("leads")
}

model Customer {
  id String @id @default(cuid())

  userId String

  name    String
  phone   String?
  email   String?
  address String?
  source  String?
  notes   String? @db.Text

  totalBookings Int @default(0)
  lastContactAt DateTime?

  lead Lead?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, phone])
  @@index([userId, email])
  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("password_reset_tokens")
}
